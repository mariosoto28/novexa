{
  "name": "novexa",
  "productName": "Novexa",
  "version": "0.1.0",
  "description": "App de escritorio para aprender programación con lecciones cortas y gamificadas.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "pyodide": "node scripts/copy-pyodide.cjs",
    "dev": "npm run pyodide && concurrently -k -n web,app \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "web": "npm run pyodide && vite",
    "build": "npm run pyodide && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "verificar": "node scripts/verificar-contenido.cjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "author": "Novexa",
  "build": {
    "appId": "com.novexa.app",
    "productName": "Novexa",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Novexa",
      "artifactName": "Novexa-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "JSCPP": "^2.0.9",
    "pyodide": "^314.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^8.0.1"
  }
}
